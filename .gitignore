node_modules/
android/.gradle/
android/build/
android/app/build/
android/local.properties
# the APK is only 2.8 MB, so it is committed — that way a fresh Render deploy
# can offer the Android download immediately, with no release needed

.DS_Store
*.log
desktop/node_modules/
desktop/out/
downloads/*.exe
downloads/*.AppImage
downloads/*.deb
downloads/*.dmg
downloads.json
update.json
.backup/

# the desktop installers are 60-90 MB each — too big for git.
# They are built by .github/workflows/release.yml and uploaded to a GitHub
# Release; the server falls back to those release assets when downloads/ is
# empty (or ./publish.sh uploads local builds with the GitHub CLI).
downloads/*.zip
Sonora-apps.zip

# The signing keystore must NOT be public. Anyone holding it can sign an APK
# that Android will accept as a genuine Sonora update. Keep it backed up
# privately (password manager, encrypted drive) — losing it means no future
# APK can install over an existing one.
apk/*.jks
apk/*.keystore
apk/sonora-signing.jks

# regenerated by release.sh; no need to version a zip of the repo itself
Sonora-source.zip

# apk/Sonora.apk is the one committed copy. downloads/ is populated by
# desktop/build.sh and publish.sh at build time.
downloads/*.apk
apk/Sonora-release.apk

# a partial Android SDK was committed by accident at some point (adb/fastboot
# binaries, ~20 MB, useless in git — it has no platforms/ or build-tools/).
# The real SDK lives on the build machine; build-apk.sh points at it.
android-sdk/

# stray uploads and an old snapshot of the project that was never referenced
uploads/
wavely/
nsis_*.deb
